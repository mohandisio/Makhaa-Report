# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets. API tokens for external data sources live here and must never
# reach git. Loaded with `source .env` before a run that needs them.
.env
.env.*

# All data stays out of git. Scraped rows are regenerated by a run;
# manual entries and overrides are local source-of-truth files, so
# data/ needs a real backup — git is not it.
data/

# Exploratory notebooks. Scratch space: executed outputs embed data
# rows, and data stays out of git. Anything worth keeping graduates
# into src/ as tested code.
notebooks/

# Notes on data problems. Kept local: they describe rows in data/,
# which is not in git either, and they go stale the moment a run fixes
# something. The working copy lives with the plan for this work.
docs/
docs/*

# Claude
.claude/

# macOS
.DS_Store
