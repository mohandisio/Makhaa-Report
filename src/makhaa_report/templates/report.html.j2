<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Yemeni coffee shops in the US</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
  :root { --ink: #1f2328; --muted: #656d76; --line: #d8dee4; --accent: #9a3412; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); background: #fbf9f6;
         font: 16px/1.5 -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem 4rem; }
  header { padding: 2.5rem 0 1rem; }
  h1 { margin: 0 0 .25rem; font-size: 1.7rem; }
  h2 { margin: 2.5rem 0 .75rem; font-size: 1.25rem; }
  .generated { color: var(--muted); margin: 0; font-size: .85rem; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
           gap: .75rem; margin-top: 1.25rem; }
  .tile { background: #fff; border: 1px solid var(--line); border-radius: 8px;
          padding: .75rem 1rem; }
  .tile b { display: block; font-size: 1.6rem; color: var(--accent); }
  .tile span { color: var(--muted); font-size: .8rem; }
  #map { height: 540px; border: 1px solid var(--line); border-radius: 8px; }
  .filters { margin: 0 0 .6rem; font-size: .85rem; color: var(--muted); }
  .filters label { margin-right: 1rem; cursor: pointer; }
  .chart-box { background: #fff; border: 1px solid var(--line); border-radius: 8px;
               padding: 1rem; margin-top: 1rem; }
  .charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .charts-row .chart-box { height: 340px; }
  @media (max-width: 760px) { .charts-row { grid-template-columns: 1fr; } }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; }
  th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .swatch { display: inline-block; width: .7em; height: .7em; border-radius: 50%;
            margin-right: .45em; }
  .note { color: var(--muted); font-size: .85rem; }
  .byline { color: var(--muted); font-size: .85rem; margin: .5rem 0 0; }
  .gh-button { display: inline-block; margin-left: .6rem; padding: .3rem .8rem;
               background: var(--ink); color: #fff; text-decoration: none;
               border-radius: 6px; font-size: .8rem; }
  .gh-button:hover { background: var(--accent); }
  footer a { color: var(--muted); }
  .badge { background: var(--accent); color: #fff; border-radius: 999px;
           font-size: .7rem; padding: .15rem .6rem; vertical-align: middle;
           text-transform: uppercase; letter-spacing: .04em; }
  .about p { max-width: 68ch; }
  .about summary { list-style: none; cursor: pointer; margin: 2.5rem 0 .75rem;
                   font-size: 1.25rem; font-weight: 600; }
  .about summary::-webkit-details-marker { display: none; }
  .about summary::before { content: "\25B8"; display: inline-block; margin-right: .4em;
                            transition: transform .15s ease; }
  .about[open] summary::before { transform: rotate(90deg); }
  .about[open] summary { margin-bottom: .75rem; }
  footer { margin-top: 3rem; color: var(--muted); font-size: .8rem; }
  .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
              gap: 1rem; margin-top: 1rem; }
  .faq-grid .chart-box h3 { margin: 0 0 .5rem; font-size: 1rem; }
  .faq-grid .chart-box p.answer { margin: 0 0 .5rem; font-size: 1.1rem; }
  .faq-grid .chart-box p.note { margin: 0; }
  .metro summary { list-style: none; cursor: pointer; margin: 2.5rem 0 .75rem;
                   font-size: 1.25rem; font-weight: 600; }
  .metro summary::-webkit-details-marker { display: none; }
  .metro summary::before { content: "\25B8"; display: inline-block; margin-right: .4em;
                            transition: transform .15s ease; }
  .metro[open] summary::before { transform: rotate(90deg); }
  .metro[open] summary { margin-bottom: .75rem; }
  #metro-select { font: inherit; padding: .35rem .5rem; margin-bottom: .75rem;
                  border: 1px solid var(--line); border-radius: 6px; }
  .metro-layout { display: grid; grid-template-columns: 3fr 2fr; gap: 1rem; }
  @media (max-width: 760px) { .metro-layout { grid-template-columns: 1fr; } }
  #metro-map { height: 360px; border: 1px solid var(--line); border-radius: 8px; }
  .metro-stats dt { color: var(--muted); font-size: .8rem; margin-top: .6rem; }
  .metro-stats dt:first-child { margin-top: 0; }
  .metro-stats dd { margin: 0; font-size: 1.05rem; }
  .metro-stats ul { list-style: none; margin: 0; padding: 0; }
  .metro-stats li { display: flex; justify-content: space-between; font-size: .9rem;
                     padding: .15rem 0; }
</style>
</head>
<body>
<main>
<header>
  <h1>Yemeni coffee shops in the US</h1>
  <p class="generated">A census of Yemeni coffee chains, scraped from each brand's own
  store locator.
  {% if data_as_of %}Data last updated <b>{{ data_as_of[:10] }}</b>.{% endif %}
  Page generated {{ generated_at }}.</p>
  <p class="byline">Made by mohandis_meem
    <a class="gh-button" href="https://github.com/mohandisio">Find me on GitHub</a></p>
  <div class="tiles">
    <div class="tile"><b>{{ headline.open }}</b><span>open now</span></div>
    <div class="tile"><b>{{ headline.coming_soon }}</b><span>coming soon</span></div>
    <div class="tile"><b>{{ headline.brands }}</b><span>brands</span></div>
    <div class="tile"><b>{{ headline.states }}</b><span>states</span></div>
  </div>
</header>

<details class="about">
  <summary>About this data</summary>
  <p>Yemeni coffee houses — serving qahwa, qishr, adeni chai and honeycomb
  bread — have been opening across the US at a remarkable pace in the last few
  years. This project tracks that wave as a census: every location of every
  chain we know about, in one place.</p>
  <p>The data is captured directly from each brand's own public store locator,
  so the brands themselves are the source of record. Addresses are normalized,
  deduplicated, and geocoded against the US Census and OpenStreetMap Nominatim
  geocoders; the handful of stores without a working locator are curated by
  hand. Only what this page displays is published — the underlying dataset
  stays private.</p>
  <p>Next up: weekly snapshots build a history, turning this page from one
  frame into a time-lapse — store counts over time, openings per month, and
  how each brand's footprint spreads.</p>
</details>

<section>
  <h2>Every shop on the map</h2>
  <div class="filters" id="status-filters">Show:</div>
  <div id="map"></div>
  {% if unmapped %}
  <p class="note">Not on the map (no coordinates yet):
    {% for shop in unmapped -%}
      {{ shop.brand_name }} — {{ shop.street }}, {{ shop.city }}, {{ shop.state }}
      {{- ", " if not loop.last }}
    {%- endfor %}.
  </p>
  {% endif %}
</section>

<section>
  <h2>The brands</h2>
  <div class="chart-box"><canvas id="brand-chart"></canvas></div>
  <div class="chart-box" style="height: 380px"><canvas id="footprint-chart"></canvas></div>
  <div class="chart-box">
    <table>
      <thead><tr><th>Brand</th><th class="num">Shops</th><th class="num">Open</th>
                 <th class="num">Coming soon</th><th class="num">States</th></tr></thead>
      <tbody>
        {% for b in brands %}
        <tr>
          <td><span class="swatch" data-brand="{{ b.slug }}"></span>{{ b.display_name }}</td>
          <td class="num">{{ b.total }}</td>
          <td class="num">{{ b.open }}</td>
          <td class="num">{{ b.coming_soon }}</td>
          <td class="num">{{ b.states }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section>
  <h2>Where they are</h2>
  <div class="charts-row">
    <div class="chart-box"><canvas id="state-chart"></canvas></div>
    <div class="chart-box"><canvas id="status-chart"></canvas></div>
  </div>
  <div class="chart-box" style="height: 340px"><canvas id="concentration-chart"></canvas></div>
</section>

<section>
  <h2>The cities</h2>
  <div class="charts-row">
    <div class="chart-box"><canvas id="cities-chart"></canvas></div>
    <div class="chart-box"><canvas id="diversity-chart"></canvas></div>
  </div>
</section>

<details class="metro">
  <summary>Explore a metro area</summary>
  <select id="metro-select">
    {% for m in payload.metros %}
    <option value="{{ loop.index0 }}">{{ m.name }} ({{ m.total }})</option>
    {% endfor %}
  </select>
  <div class="metro-layout">
    <div id="metro-map"></div>
    <dl class="metro-stats" id="metro-stats"></dl>
  </div>
</details>

<section>
  <h2>Growth over time</h2>
  <div class="chart-box" style="height: 340px"><canvas id="openings-by-year-chart"></canvas></div>
  <p class="note">{{ payload.openings_by_year.dated }} of {{ payload.openings_by_year.dated + payload.openings_by_year.undated }} shops have a dated opening; the rest are undated. Dates come from permit and licence records, accurate to about a month.</p>
  <p class="note">
    {% for level, n in payload.openings_by_year.confidence.items() -%}
      {{ n }} {{ level }}{{ ", " if not loop.last }}
    {%- endfor %}.
  </p>
  <p class="note">The census runs weekly. As snapshots accumulate, this section
  will also list newly opened shops run by run. For now, the announced
  openings show where the wave is heading next.</p>
  <div class="chart-box" style="height: 340px"><canvas id="coming-soon-chart"></canvas></div>
</section>

<section>
  <h2>Questions the data answers</h2>
  <div class="faq-grid">
    {% for entry in faq %}
    <div class="chart-box">
      <h3>{{ entry.question }}</h3>
      <p class="answer">{{ entry.answer }}</p>
      <p class="note">{{ entry.note }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<footer>Data comes from each brand's public store locator; positions from the
locators themselves or the US Census / Nominatim geocoders.
Made by mohandis_meem — <a href="https://github.com/mohandisio">GitHub</a>.</footer>
</main>

<script id="report-data" type="application/json">{{ payload | tojson }}</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
"use strict";
const DATA = JSON.parse(document.getElementById("report-data").textContent);
const pretty = s => (s[0].toUpperCase() + s.slice(1)).replace(/_/g, " ");

/* Brand color swatches in the league table. */
for (const el of document.querySelectorAll(".swatch")) {
  el.style.background = DATA.brand_colors[el.dataset.brand];
}

/* ---- Map ---------------------------------------------------------- */
const map = L.map("map", { scrollWheelZoom: true });
L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
  maxZoom: 19,
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
}).addTo(map);

function popupFor(shop) {
  const div = document.createElement("div");
  const add = (text, tag = "div") => {
    if (!text) return;
    const el = document.createElement(tag);
    el.textContent = text;            /* never innerHTML: scraped strings */
    div.appendChild(el);
  };
  add(shop.brand_name, "b");
  add(`${shop.street}, ${shop.city}, ${shop.state}`);
  if (shop.status !== "open") add(pretty(shop.status));
  add(shop.phone);
  add(shop.hours);
  return div;
}

const HIDDEN_BY_DEFAULT = new Set(["closed_permanently"]);
const groups = {};                    /* status -> layerGroup */
for (const shop of DATA.shops) {
  const marker = L.circleMarker([shop.lat, shop.lon], {
    radius: 6, weight: 1, fillOpacity: 0.85,
    color: "#ffffff", fillColor: DATA.brand_colors[shop.brand],
  }).bindPopup(popupFor(shop));
  (groups[shop.status] ??= L.layerGroup()).addLayer(marker);
}

function refit() {
  const bounds = L.latLngBounds([]);
  for (const [status, group] of Object.entries(groups)) {
    if (!map.hasLayer(group)) continue;
    group.eachLayer(m => bounds.extend(m.getLatLng()));
  }
  if (bounds.isValid()) map.fitBounds(bounds.pad(0.1));
}

const filters = document.getElementById("status-filters");
for (const { status, total } of DATA.statuses) {
  const label = document.createElement("label");
  const box = document.createElement("input");
  box.type = "checkbox";
  box.checked = !HIDDEN_BY_DEFAULT.has(status);
  box.addEventListener("change", () => {
    map[box.checked ? "addLayer" : "removeLayer"](groups[status]);
    refit();
  });
  label.appendChild(box);
  label.appendChild(document.createTextNode(` ${pretty(status)} (${total})`));
  filters.appendChild(label);
  if (box.checked) map.addLayer(groups[status]);
}
refit();

/* ---- Charts ------------------------------------------------------- */
Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
Chart.defaults.plugins.legend.display = false;

new Chart(document.getElementById("brand-chart"), {
  type: "bar",
  data: {
    labels: DATA.brands.map(b => b.display_name),
    datasets: [{ data: DATA.brands.map(b => b.total),
                 backgroundColor: DATA.brands.map(b => DATA.brand_colors[b.slug]) }],
  },
  options: { indexAxis: "y", maintainAspectRatio: false },
});
document.getElementById("brand-chart").parentElement.style.height =
  `${DATA.brands.length * 26 + 60}px`;

new Chart(document.getElementById("state-chart"), {
  type: "bar",
  data: {
    labels: DATA.states.map(s => s.state),
    datasets: [{ data: DATA.states.map(s => s.total), backgroundColor: "#9a3412" }],
  },
  options: { maintainAspectRatio: false,
             plugins: { title: { display: true, text: "Shops per state" } } },
});

new Chart(document.getElementById("footprint-chart"), {
  type: "scatter",
  data: {
    datasets: [true, false].map(isFranchise => ({
      label: isFranchise ? "Franchise" : "Independent",
      data: DATA.brands.filter(b => Boolean(b.franchises) === isFranchise)
                       .map(b => ({ x: b.total, y: b.states, name: b.display_name })),
      backgroundColor: isFranchise ? "#D55E00" : "#0072B2",
      pointRadius: 6, pointHoverRadius: 8,
    })),
  },
  options: {
    maintainAspectRatio: false,
    plugins: {
      legend: { display: true, position: "bottom" },
      title: { display: true, text: "Brand footprint: shops vs states covered" },
      tooltip: { callbacks: { label: ctx =>
        `${ctx.raw.name}: ${ctx.raw.x} shops in ${ctx.raw.y} state${ctx.raw.y > 1 ? "s" : ""}` } },
    },
    scales: { x: { title: { display: true, text: "shops" } },
              y: { title: { display: true, text: "states" }, ticks: { precision: 0 } } },
  },
});

new Chart(document.getElementById("concentration-chart"), {
  type: "bar",
  data: {
    labels: DATA.concentration.map(c => c.state),
    datasets: [{ data: DATA.concentration.map(c => c.share),
                 backgroundColor: DATA.concentration.map(c => {
                   const brand = DATA.brands.find(b => b.display_name === c.leader);
                   return brand ? DATA.brand_colors[brand.slug] : "#9aa0a6";
                 }) }],
  },
  options: {
    maintainAspectRatio: false,
    plugins: {
      title: { display: true, text: "Leading brand's share of each state (5+ shops)" },
      tooltip: { callbacks: { label: ctx => {
        const c = DATA.concentration[ctx.dataIndex];
        return `${c.leader}: ${c.leader_shops} of ${c.total} shops`;
      } } },
    },
    scales: { y: { min: 0, max: 1, ticks: { format: { style: "percent" } } } },
  },
});

new Chart(document.getElementById("cities-chart"), {
  type: "bar",
  data: {
    labels: DATA.top_cities.map(c => c.label),
    datasets: [{ data: DATA.top_cities.map(c => c.total), backgroundColor: "#9a3412" }],
  },
  options: { indexAxis: "y", maintainAspectRatio: false,
             plugins: { title: { display: true, text: "Most shops" } } },
});

new Chart(document.getElementById("diversity-chart"), {
  type: "bar",
  data: {
    labels: DATA.city_diversity.map(c => c.label),
    datasets: [{ data: DATA.city_diversity.map(c => c.brands), backgroundColor: "#0072B2" }],
  },
  options: {
    indexAxis: "y", maintainAspectRatio: false,
    plugins: {
      title: { display: true, text: "Most distinct brands" },
      tooltip: { callbacks: { label: ctx => {
        const c = DATA.city_diversity[ctx.dataIndex];
        return `${c.brands} brands, ${c.total} shops`;
      } } },
    },
    scales: { x: { ticks: { precision: 0 } } },
  },
});

{
  const states = [...new Set(DATA.coming_soon.map(r => r.state))];
  states.sort((a, b) =>
    DATA.coming_soon.filter(r => r.state === b).reduce((n, r) => n + r.total, 0) -
    DATA.coming_soon.filter(r => r.state === a).reduce((n, r) => n + r.total, 0));
  const brands = [...new Set(DATA.coming_soon.map(r => r.brand))];
  new Chart(document.getElementById("coming-soon-chart"), {
    type: "bar",
    data: {
      labels: states,
      datasets: brands.map(brand => {
        const rows = DATA.coming_soon.filter(r => r.brand === brand);
        return {
          label: rows[0].brand_name,
          data: states.map(s => rows.find(r => r.state === s)?.total ?? 0),
          backgroundColor: DATA.brand_colors[brand],
        };
      }),
    },
    options: {
      maintainAspectRatio: false,
      plugins: { legend: { display: true, position: "bottom" },
                 title: { display: true, text: "Announced openings by state" } },
      scales: { x: { stacked: true },
                y: { stacked: true, ticks: { precision: 0 } } },
    },
  });
}

new Chart(document.getElementById("openings-by-year-chart"), {
  type: "bar",
  data: {
    labels: DATA.openings_by_year.years,
    datasets: DATA.openings_by_year.series.map(s => ({
      label: s.display_name,
      data: s.counts,
      backgroundColor: s.slug === "other" ? "#9aa0a6" : DATA.brand_colors[s.slug],
    })),
  },
  options: {
    maintainAspectRatio: false,
    plugins: { legend: { display: true, position: "bottom" },
               title: { display: true, text: "Shop openings by year" } },
    scales: { x: { stacked: true },
              y: { stacked: true, ticks: { precision: 0 } } },
  },
});

/* ---- Metro explorer ------------------------------------------------ */
{
  const details = document.querySelector(".metro");
  const select = document.getElementById("metro-select");
  const statsEl = document.getElementById("metro-stats");
  let metroMap = null;
  let metroLayer = null;

  function renderStats(metro) {
    const brandRows = metro.brands.map(b =>
      `<li><span>${b.display_name}</span><span>${b.count}</span></li>`).join("");
    statsEl.innerHTML = `
      <dt>Shops</dt><dd>${metro.total}</dd>
      <dt>Open vs announced</dt><dd>${metro.open} open, ${metro.coming_soon} coming soon</dd>
      <dt>Brands</dt><dd><ul>${brandRows}</ul></dd>
      <dt>Top brand share</dt><dd>${Math.round(metro.top_share * 100)}%</dd>
      <dt>First dated opening</dt>
      <dd>${metro.first_opening ?? "unknown"} (${metro.dated} of ${metro.total} dated)</dd>
    `;
  }

  function renderMap(metro) {
    if (!metroMap) return;
    if (metroLayer) metroMap.removeLayer(metroLayer);
    metroLayer = L.layerGroup();
    const bounds = L.latLngBounds([]);
    for (const i of metro.shops) {
      const shop = DATA.shops[i];
      if (!shop) continue;
      const marker = L.circleMarker([shop.lat, shop.lon], {
        radius: 6, weight: 1, fillOpacity: 0.85,
        color: "#ffffff", fillColor: DATA.brand_colors[shop.brand],
      }).bindPopup(popupFor(shop));
      metroLayer.addLayer(marker);
      bounds.extend([shop.lat, shop.lon]);
    }
    metroLayer.addTo(metroMap);
    if (bounds.isValid()) {
      metroMap.fitBounds(bounds.pad(0.1));
    } else {
      metroMap.setView([metro.center.lat, metro.center.lon], 10);
    }
  }

  function showSelected() {
    const metro = DATA.metros[Number(select.value)];
    if (!metro) return;
    renderStats(metro);
    renderMap(metro);
  }

  function ensureMap() {
    if (metroMap) return;
    metroMap = L.map("metro-map", { scrollWheelZoom: true });
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(metroMap);
    metroMap.invalidateSize();
    showSelected();
  }

  if (DATA.metros.length) {
    renderStats(DATA.metros[0]);
    details.addEventListener("toggle", () => {
      if (details.open) ensureMap();
    });
    select.addEventListener("change", showSelected);
    window.addEventListener("resize", () => {
      if (metroMap) metroMap.invalidateSize();
    });
  }
}

const STATUS_COLORS = { coming_soon: "#D55E00", open: "#009E73", relocating: "#CC79A7",
                        closed_permanently: "#9aa0a6", unknown: "#F0E442" };
new Chart(document.getElementById("status-chart"), {
  type: "doughnut",
  data: {
    labels: DATA.statuses.map(s => pretty(s.status)),
    datasets: [{ data: DATA.statuses.map(s => s.total),
                 backgroundColor: DATA.statuses.map(s => STATUS_COLORS[s.status]) }],
  },
  options: { maintainAspectRatio: false,
             plugins: { legend: { display: true, position: "bottom" },
                        title: { display: true, text: "Status" } } },
});
</script>
</body>
</html>
